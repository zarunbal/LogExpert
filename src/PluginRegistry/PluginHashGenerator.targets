<Project>
  <PropertyGroup>
    <GeneratePluginHashesEnabled>true</GeneratePluginHashesEnabled>
    <PluginHashGeneratorFile>$(MSBuildThisFileDirectory)PluginHashGenerator.Generated.cs</PluginHashGeneratorFile>
  </PropertyGroup>

  <!-- Target to generate plugin hashes during build -->
  <Target Name="GeneratePluginHashes" 
          AfterTargets="Build" 
          Condition="'$(GeneratePluginHashesEnabled)' == 'true' AND '$(Configuration)' == 'Release' AND Exists('$(OutputPath)plugins')">
    
    <Message Text="Generating plugin hashes from $(OutputPath)plugins..." Importance="high" />
    
    <!-- Run the hash generator tool -->
    <Exec Command="dotnet run --project $(MSBuildThisFileDirectory)..\PluginHashGenerator.Tool\PluginHashGenerator.Tool.csproj -- &quot;$(OutputPath)&quot; &quot;$(PluginHashGeneratorFile)&quot; $(Configuration)" 
          WorkingDirectory="$(MSBuildThisFileDirectory).."
          ContinueOnError="false"
          IgnoreExitCode="false" />
          
    <Message Text="Plugin hash file generated: $(PluginHashGeneratorFile)" Importance="high" />
  </Target>

  <!-- Make the generated file part of the compilation if it exists -->
  <ItemGroup>
    <Compile Include="$(PluginHashGeneratorFile)" Condition="Exists('$(PluginHashGeneratorFile)')" />
  </ItemGroup>
</Project>
